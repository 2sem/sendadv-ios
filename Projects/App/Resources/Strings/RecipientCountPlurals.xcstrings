    "rule.detail.recipient.count.value" : {
      "comment" : "Pinned recipient-count bar value on RuleDetailScreen. Kept in a scoped catalog (not Localizable.strings/.strings) so the English plural rule (one/other) can be expressed correctly. Korean has no plural distinction and only defines \"other\".",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%d recipient"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%d recipients"
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%d명"
                }
              }
            }
          }
        }
      }
    }
  },
  "version" : "1.0"
}
